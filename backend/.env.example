PORT=5000
# Real server example:
# MONGODB_URI=mongodb+srv://USER:PASS@HOST/QA?appName=gigkaro
# Local without mongod: memory
MONGODB_URI=memory
JWT_SECRET=change-me-in-production
CORS_ORIGIN=http://127.0.0.1:3000
DEV_OTP=123456

ADMIN_IDENTIFIERS=9999999999,admin@gigkaro.local

# Contact form is delivered with FormSubmit to this inbox.
CONTACT_TO=info@gigkaro.in

# Blog covers and company logos. The bucket must allow public reads.
GCS_BUCKET=
GCS_PROJECT_ID=
GCS_CLIENT_EMAIL=
GCS_PRIVATE_KEY=

# WhatsApp alert (Meta Cloud API) when a candidate applies.
# Meta Business Manager > WhatsApp > API setup. Phone number ID is the numeric ID, not the display number.
# Access token: system-user token with whatsapp_business_messaging. WABA ID is only used to list templates.
META_GRAPH_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WABA_ID=
# Approved template; body must use {{1}} job title, {{2}} locality, {{3}} candidate name, {{4}} candidate mobile.
WHATSAPP_APPLICATION_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Comma-separated; 10-digit numbers get the 91 prefix.
WHATSAPP_NOTIFY_TO=8714500637
