NEXT_PUBLIC_API_URL=http://127.0.0.1:5000/api
NEXT_PUBLIC_SITE_URL=https://gigkaro.in

# Sitemap drips (IST). Unset = list everything at once.
# Batches unlock at rotating times (10-day IST cycle: 09:17, 10:42, …).
SITEMAP_DRIP_START=2026-11-03
SITEMAP_JOBS_PER_DAY=50
# Localities ramp: 7 days @100/day → 7 @150/day → then 200/day.
SITEMAP_LOCALITIES_RAMP=7:100,7:150,200
SITEMAP_LOCATION_DRIP_START=2026-11-03
